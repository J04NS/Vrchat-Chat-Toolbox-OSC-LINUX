# Pelikan / Pterodactyl HypeRate Relay Server Konfiguration
# 
# Trage hier deinen geheimen HypeRate API Key ein.
# Dieser Key bleibt ausschließlich auf deinem Pelikan-Server und wird niemals an Clients gesendet!
HYPERATE_API_KEY=hier_deinen_hyperate_api_key_eintragen

# Port, auf dem der Relay-Server lauscht (Standard in Pelikan oft die zugewiesene Server-Portnummer, z. B. 8080 oder 7871)
PORT=8080

# Optional: Shared Secret Token zur Authentifizierung deiner Freunde/Clients (leer lassen, wenn jeder mit Session-ID verbinden darf)
RELAY_SECRET=
